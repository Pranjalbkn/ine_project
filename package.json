{
  "name": "ine-price-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node src/server.js",
    "dev:web": "vite client --host 127.0.0.1",
    "build": "vite build client",
    "start": "node src/server.js",
    "scrape": "node src/scrape-cli.js",
    "scrape:headed": "node src/scrape-cli.js --headed",
    "catalog:sync": "node src/catalog-cli.js --sync",
    "catalog:search": "node src/catalog-cli.js --search",
    "db:migrate": "node src/migrate.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "playwright": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.0"
  }
}
