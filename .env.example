# Copy this file to .env and replace the value locally. Never commit .env.
# Use the connection string from Supabase > Connect. A session pooler string
# works when your computer or host cannot reach the direct IPv6 endpoint.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Set a long random value before configuring the external two-hour cron job.
CRON_SECRET=replace-with-a-long-random-secret

# Set this to the deployed Vercel origin after deployment.
FRONTEND_ORIGIN=http://127.0.0.1:5173
PORT=3001
